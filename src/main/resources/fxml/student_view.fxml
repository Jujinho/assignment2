<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.StudentController">
   <top>
      <VBox alignment="CENTER" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" text="University Equipment Lending System" BorderPane.alignment="CENTER">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" top="20.0" />
               </VBox.margin>
            </Label>
            <Label text="Student Dashboard">
               <font>
                  <Font size="18.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            <Label fx:id="welcomeLabel" text="Welcome, Student Name">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
   </top>
   <center>
      <TabPane prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <Tab text="Personal Information">
               <content>
                  <VBox spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="First Name:" />
                              <TextField fx:id="firstNameField" prefHeight="30.0" prefWidth="200.0" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Last Name:" />
                              <TextField fx:id="lastNameField" prefHeight="30.0" prefWidth="200.0" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Email:" />
                              <TextField fx:id="emailField" prefHeight="30.0" prefWidth="200.0" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Phone Number:" />
                              <TextField fx:id="phoneField" prefHeight="30.0" prefWidth="200.0" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Date of Birth:" />
                              <DatePicker fx:id="dobPicker" prefHeight="30.0" prefWidth="200.0" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Address:" />
                              <TextField fx:id="addressField" prefHeight="30.0" prefWidth="200.0" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Student ID:" />
                              <TextField fx:id="studentIdField" disable="true" prefHeight="30.0" prefWidth="200.0" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Major:" />
                              <TextField fx:id="majorField" disable="true" prefHeight="30.0" prefWidth="200.0" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Year:" />
                              <TextField fx:id="yearField" disable="true" prefHeight="30.0" prefWidth="200.0" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER" spacing="20.0">
                           <children>
                              <Button fx:id="updateInfoButton" mnemonicParsing="false" onAction="#handleUpdateInfo" prefHeight="30.0" prefWidth="150.0" text="Update Information" />
                              <Button fx:id="changePasswordButton" mnemonicParsing="false" onAction="#handleChangePassword" prefHeight="30.0" prefWidth="150.0" text="Change Password" />
                           </children>
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </HBox>
                     </children>
                  </VBox>
               </content>
          </Tab>
          <Tab text="Lending History">
               <content>
                  <VBox spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="From Date:" />
                              <DatePicker fx:id="fromDatePicker" prefHeight="30.0" prefWidth="150.0" />
                              <Label text="To Date:" />
                              <DatePicker fx:id="toDatePicker" prefHeight="30.0" prefWidth="150.0" />
                              <ComboBox fx:id="statusComboBox" prefHeight="30.0" prefWidth="150.0" promptText="Status" />
                              <Button fx:id="filterHistoryButton" mnemonicParsing="false" onAction="#handleFilterHistory" prefHeight="30.0" text="Filter" />
                           </children>
                           <VBox.margin>
                              <Insets bottom="10.0" />
                           </VBox.margin>
                        </HBox>
                        <TableView fx:id="lendingHistoryTable" prefHeight="400.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="equipmentNameColumn" prefWidth="150.0" text="Equipment" />
                            <TableColumn fx:id="borrowDateColumn" prefWidth="100.0" text="Borrow Date" />
                            <TableColumn fx:id="dueDateColumn" prefWidth="100.0" text="Due Date" />
                            <TableColumn fx:id="returnDateColumn" prefWidth="100.0" text="Return Date" />
                            <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status" />
                            <TableColumn fx:id="courseColumn" prefWidth="100.0" text="Course" />
                            <TableColumn fx:id="actionColumn" prefWidth="100.0" text="Action" />
                          </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
               </content>
          </Tab>
          <Tab text="Borrow Equipment">
               <content>
                  <VBox spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="Search:" />
                              <TextField fx:id="searchEquipmentField" prefHeight="30.0" prefWidth="200.0" promptText="Enter equipment name" />
                              <Label text="Category:" />
                              <ComboBox fx:id="categoryComboBox" prefHeight="30.0" prefWidth="150.0" promptText="Select category" />
                              <Label text="Condition:" />
                              <ComboBox fx:id="conditionComboBox" prefHeight="30.0" prefWidth="150.0" promptText="Select condition" />
                              <Button fx:id="searchEquipmentButton" mnemonicParsing="false" onAction="#handleSearchEquipment" prefHeight="30.0" text="Search" />
                           </children>
                           <VBox.margin>
                              <Insets bottom="10.0" />
                           </VBox.margin>
                        </HBox>
                        <TableView fx:id="equipmentTable" prefHeight="300.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="eqNameColumn" prefWidth="150.0" text="Name" />
                            <TableColumn fx:id="eqCategoryColumn" prefWidth="100.0" text="Category" />
                            <TableColumn fx:id="eqConditionColumn" prefWidth="100.0" text="Condition" />
                            <TableColumn fx:id="eqManufacturerColumn" prefWidth="120.0" text="Manufacturer" />
                            <TableColumn fx:id="eqModelColumn" prefWidth="100.0" text="Model" />
                            <TableColumn fx:id="eqAvailableColumn" prefWidth="75.0" text="Available" />
                            <TableColumn fx:id="eqActionColumn" prefWidth="100.0" text="Action" />
                          </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="Course:" />
                              <ComboBox fx:id="courseComboBox" prefHeight="30.0" prefWidth="200.0" promptText="Select course" />
                              <Label text="Purpose:" />
                              <TextField fx:id="purposeField" prefHeight="30.0" prefWidth="200.0" promptText="Enter purpose" />
                           </children>
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </HBox>
                     </children>
                  </VBox>
               </content>
          </Tab>
        </tabs>
      </TabPane>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" prefHeight="30.0" prefWidth="100.0" text="Logout" />
         </children>
         <BorderPane.margin>
            <Insets bottom="20.0" top="10.0" />
         </BorderPane.margin>
      </HBox>
   </bottom>
</BorderPane>